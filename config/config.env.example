# Learning OS config template.
#
# Copy this file to ~/.learning-os/config.env and fill in the values, OR run
# /learning-os-setup, which creates the Notion side of this automatically and writes
# most of these for you. Never commit your real ~/.learning-os/config.env anywhere —
# it holds a live API token and your personal database IDs.

# --- Notion ---
# Create an integration at https://www.notion.so/my-integrations, copy its secret here.
NOTION_API_TOKEN=

# The 13 Learning OS database IDs. /learning-os-setup fills these in automatically after
# building the databases in your workspace. If you're wiring this up by hand instead
# (see docs/NOTION_SCHEMA.md), paste each database's ID here.
NOTION_DB_LEARNING_LAYERS=
NOTION_DB_COURSES=
NOTION_DB_LESSONS=
NOTION_DB_SKILLS_MASTER=
NOTION_DB_LESSON_SKILL_BRIDGE=
NOTION_DB_PROJECTS_SOFTWARE=
NOTION_DB_PROJECTS_HARDWARE=
NOTION_DB_LEARNING_LOG=
NOTION_DB_LESSON_RESOURCES=
NOTION_DB_TEXTBOOKS=
NOTION_DB_TEXTBOOK_RESOURCES=
NOTION_DB_CHAOS_HOUR=
NOTION_DB_BOOTCAMP=

# The top-level "Learning OS" dashboard page /learning-os-setup creates. Not required by
# any command directly, but useful to have on hand.
NOTION_DASHBOARD_PAGE_ID=

# --- NotebookLM ---
# Each tutor (except coursetutor, which picks a notebook interactively every session) saves
# to one dedicated notebook. Create these with `notebooklm create "<title>"` (after
# `notebooklm login`) and paste the returned IDs here, or let /learning-os-setup prompt you.
NOTEBOOK_TUTOR=
NOTEBOOK_MATHTUTOR=
NOTEBOOK_HARDWARETUTOR=
NOTEBOOK_PROBLEMOFTHEDAY=
NOTEBOOK_CODE_EXPLAINER=

# --- GitHub ---
# Used by hardwaretutor and coursetutor's project-completion flow (`gh repo create`).
GITHUB_USERNAME=

# --- Filesystem paths ---
# Where the commands read/write concept notes, daily notes, problem-session progress, and
# code-reader sessions. Defaults below assume a single "life"/notes folder in your home
# directory — point these anywhere you actually keep notes (e.g. an Obsidian vault).
LEARNING_OS_VAULT_ROOT="$HOME/life"
LEARNING_OS_PROBLEM_SESSIONS="$HOME/problem-sessions"
LEARNING_OS_CODE_READER_DIR="$HOME/study/AI & CS/code-reader"
LEARNING_OS_PROJECTS_DIR="$HOME/projects"

# --- Personalization (optional) ---
# A markdown file describing your background/goals, read by tutor/mathtutor/problemoftheday/
# coursetutor to calibrate depth and tone. See config/USER_PROFILE.example.md for the format.
# Leave blank (or point at a nonexistent file) to fall back to each command's shipped default.
LEARNING_OS_USER_PROFILE_PATH="$HOME/.learning-os/USER_PROFILE.md"
